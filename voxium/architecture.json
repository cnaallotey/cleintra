{
  "version": 1,
  "modules": {
    "app": {
      "paths": [
        "src/app/**"
      ],
      "description": "Files under src/app/"
    },
    "components": {
      "paths": [
        "src/components/**"
      ],
      "description": "Files under src/components/"
    },
    "lib": {
      "paths": [
        "src/lib/**"
      ],
      "description": "Files under src/lib/"
    },
    "types": {
      "paths": [
        "src/types/**"
      ],
      "description": "Files under src/types/"
    }
  },
  "layers": [
    "app",
    "components",
    "lib",
    "types"
  ],
  "rules": [
    {
      "id": "CYCLE01",
      "type": "no_cycles",
      "severity": "block",
      "description": "Modules must not depend on each other in a cycle.",
      "rationale": "Cycles make modules impossible to change, test or extract on their own."
    },
    {
      "id": "SIZE01",
      "type": "max_file_lines",
      "max": 600,
      "severity": "warn",
      "description": "Source files should stay under 600 lines.",
      "rationale": "Very large files usually mix responsibilities and are hard for humans and agents to change safely."
    }
  ],
  "exceptions": []
}
